# ---- App ----
APP_NAME=ilé
APP_URL=http://localhost:3000
# Local default is an embedded Postgres (PGlite) stored in .data/pglite.
# For Supabase/production use the Postgres connection string (pooler, port 6543 or 5432).
DATABASE_URL=
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
SESSION_SECRET=
JOBS_TICK_SECRET=

# ---- Supabase (production target; optional in mock mode) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI ----
LLM_MODE=mock               # mock | live
ANTHROPIC_API_KEY=
CLAUDE_MODEL_FAST=claude-haiku-4-5
CLAUDE_MODEL_SMART=         # left empty in the beta to protect the budget
AI_DAILY_BUDGET_USD=0.50

# ---- WhatsApp Cloud API ----
MOCK_WHATSAPP=true
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
# Used only when MOCK_WHATSAPP=false and the org has no stored connection yet
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ---- Storage ----
MOCK_STORAGE=true

# ---- Errors (optional) ----
SENTRY_DSN=
